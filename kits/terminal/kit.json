{
  "name": "terminal",
  "version": 1,
  "entry": "kit.js",
  "describe": "Signature Terminal style: the session replayed on a single-phosphor CRT (P3 amber), box-drawn panes, human-cadence typing, odometer stats, block-letter logos, dither-to-real product captures, channel-switch cuts.",
  "requires": ["base"],
  "theme": "terminal",
  "scenes": ["HOOK", "TITLE", "PROBLEM", "PLAN", "CODE", "DIFF", "TERMINAL", "MONTAGE", "SCREEN", "STATS",
             "BEFORE_AFTER", "CALLOUT", "END", "FEATURE", "SCROLL"],
  "transitions_defined": ["kit:terminal/channel-switch", "kit:terminal/persist"],
  "fonts": [
    {"family": "IBM Plex Mono", "src": "fonts/IBMPlexMono-Regular.ttf", "weight": "400", "style": "normal"},
    {"family": "IBM Plex Mono", "src": "fonts/IBMPlexMono-Medium.ttf", "weight": "500", "style": "normal"},
    {"family": "IBM Plex Mono", "src": "fonts/IBMPlexMono-SemiBold.ttf", "weight": "600", "style": "normal"},
    {"family": "VT323", "src": "fonts/VT323-Regular.ttf", "weight": "400", "style": "normal"},
    {"family": "JetBrains Mono", "src": "fonts/JetBrainsMono-Variable.ttf", "weight": "100 800", "style": "normal"}
  ],
  "licenses": ["fonts/OFL-IBMPlexMono.txt", "fonts/OFL-VT323.txt", "fonts/OFL-JetBrainsMono.txt"],
  "finish": {"grain": 0.0, "vignette": 0.0},
  "transitions": {"cut": ["kit:terminal/persist", 0.14], "match": ["kit:terminal/persist", 0.2],
                  "push": ["kit:terminal/channel-switch", 0.3], "wipe": ["kit:terminal/channel-switch", 0.3]},
  "caption_style": {"font": "IBM Plex Mono", "size": 42, "weight": 500, "color": "#FFB13B", "bg": "rgba(12,8,5,0.9)",
                    "letterSpacing": "0"},
  "background": "#050302",
  "render": {"post": "crt", "post_params": {"crt": {"glow": 0.6, "scanline": 0.0, "curvature": 0.055, "vignette": 0.42}}},
  "style": {
    "id": "terminal",
    "name": "Terminal",
    "blurb": "Phosphor CRT terminal: box-drawn panes, typed commands, odometer stats",
    "voice_speed": 1.0,
    "phosphor": "p3",
    "palette": {"phosphor": "#FFB13B", "hot": "#FFE6B8", "mid": "#C98A2C", "dim": "#7C531A", "faint": "#3A2609",
                "glass": "#0C0805", "glass_lit": "#1A1108"},
    "palette_p1": {"phosphor": "#4BFF86", "hot": "#D9FFE6", "mid": "#35C268", "dim": "#1E7A40", "faint": "#0E3A1E",
                   "glass": "#040905", "glass_lit": "#0A160D"},
    "fonts": {"grid": "IBM Plex Mono", "display": "VT323", "fallback": "JetBrains Mono"},
    "bpm": [100, 114],
    "music": ["terminal_a", "terminal_b"],
    "sfx": {"cut": "glitch", "move": "glitch", "click": "relay", "type": "key", "appear": "beep", "pass": "beep",
            "fail": "error", "hit": "relay", "hero": "sub_drop", "build": "riser", "shot": "shutter"},
    "post": "crt",
    "post_params": {"crt": {"glow": 0.6, "scanline": 0.0, "curvature": 0.055, "vignette": 0.42}}
  }
}
