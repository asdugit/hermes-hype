   "title": "tally/parser.py",
   "summary": "+39 in tally/parser.py",
   "data": {
    "path": "tally/parser.py",
    "lang": "python",
    "lines": [
     "\"\"\"Parse bank CSV exports into transactions.\"\"\"",
     "from __future__ import annotations",
     "",
     "import csv",
     "from dataclasses import dataclass",
     "from datetime import date",
     "from decimal import Decimal",
     "from pathlib import Path",
     "",
     "",
     "@dataclass(frozen=True)",
     "class Transaction:",
     "    day: date",
     "    description: str",
     "    amount: Decimal",
     "    category: str = \"uncategorized\"",
     "",
     "",
     "def parse_amount(raw: str) -> Decimal:",
     "    \"\"\"Turn '1,234.50' or '(12.50)' into a signed Decimal.\"\"\"",
     "    text = raw.strip().replace(\",\", \"\")",
     "    if text.startswith(\"(\") and text.endswith(\")\"):",
     "        return -Decimal(text[1:-1])",
     "    return Decimal(text)",
     "",
     "",
     "def parse_file(path: Path) -> list[Transaction]:",
     "    \"\"\"Read one export; skips blank rows and the bank's footer.\"\"\"",
     "    rows: list[Transaction] = []",
     "    with path.open(encoding=\"utf-8-sig\", newline=\"\") as fh:",
     "        for row in csv.DictReader(fh):",
     "            if not row.get(\"Date\"):",
     "                continue",
     "            rows.append(Transaction(",
     "                day=date.fromisoformat(row[\"Date\"]),",
     "                description=row[\"Description\"].strip(),",
     "                amount=parse_amount(row[\"Amount\"]),",
     "            ))",
     "    return rows"
    ],
    "new_file": true
   },
   "ok": true,
   "weight": 0.6
  },
  {
